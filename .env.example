# persian-form-agent — LLM configuration
#
# Copy this file to `.env` in your target project root (next to agent.config.json).
# With no configuration at all, the CLI targets a local FreeDeepseekAPI server
# and requires no billing.

# Base URL of an Anthropic-Messages-compatible endpoint (origin only, no path).
# The client calls <LLM_BASE_URL>/v1/messages.
LLM_BASE_URL=http://127.0.0.1:9655

# Model id passed on every request. FreeDeepseekAPI supports DeepSeek models.
LLM_MODEL=deepseek-chat

# Sent as the x-api-key header. FreeDeepseekAPI ignores it; any value works.
LLM_API_KEY=dummy

# --- Using the real Anthropic API instead (optional) ---
# LLM_* is the only configuration the CLI reads; ambient ANTHROPIC_* vars are
# ignored. To target the real Anthropic API, set:
# LLM_BASE_URL=https://api.anthropic.com
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-20250514
